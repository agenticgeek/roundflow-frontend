VITE_SUPABASE_ANON_KEY=your-anon-key

# RoundFlow API — app data AND auth proxy (POST /auth/v1/token, etc.)
VITE_API_URL=https://api-dev.roundflow.ai

# Optional override if GoTrue is not proxied on the API host (local backend only).
# When unset, the Supabase client uses VITE_API_URL.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Optional — bypass setup-flow redirects when previewing a production build locally.
# Not needed for `npm run dev` (bypass is automatic in development).
# VITE_BYPASS_SETUP_GATE=true
