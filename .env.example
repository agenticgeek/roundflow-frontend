VITE_SUPABASE_URL=https://cixtfdnuwbmxvilkvihv.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# RoundFlow API — app data (GET /auth/me, customers, setup, …).
# `npm run dev` proxies this host via /__rf so localhost:5173 is not blocked by CORS.
VITE_API_URL=https://api-dev.roundflow.ai

# Optional — bypass setup-flow redirects when previewing a production build locally.
# Not needed for `npm run dev` (bypass is automatic in development).
# VITE_BYPASS_SETUP_GATE=true

# Round Planner's Map view — Google Cloud API key with "Maps JavaScript API" and
# "Geocoding API" enabled (console.cloud.google.com → APIs & Services). Restrict it
# to your app's HTTP referrers. Without this, Map view shows a setup notice instead.
VITE_GOOGLE_MAPS_API_KEY=
